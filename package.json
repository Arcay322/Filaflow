{
  "name": "filaflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/inventory.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-filaflow \"vitest run tests/firestore.test.ts\"",
    "lint": "eslint .",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-filaflow",
    "deploy": "npm run build && firebase deploy --only firestore:rules,firestore:indexes,hosting --project filaflow-a856b"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "firebase": "12.19.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.32.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "basic-ftp": "6.2.2"
  }
}
